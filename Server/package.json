{
  "name": "color-web-server",
  "version": "1.0.0",
  "description": "Color Web Backend Server",
  "main": "server.js",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "set NODE_ENV=development && nodemon server.js",
    "prod": "set NODE_ENV=production && nodemon server.js",
    "dev-local": "set USE_LOCAL_DB=true && nodemon server.js",
    "create-admin": "node scripts/createAdmin.js",
    "create-admin-local": "node scripts/createAdmin.js --local",
    "backfill-imgurl": "node scripts/backfillImgUrl.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2",
    "express": "^4",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^8",
    "multer": "^2.0.2",
    "path": "^0.12.7",
    "pdfjs-dist": "5.4.624"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
